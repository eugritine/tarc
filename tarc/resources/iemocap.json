{
  "model": {
    "modalities": [
      "text",
      "audio",
      "vision"
    ],
    "input_dims": {
      "text": 1024,
      "audio": 100,
      "vision": 512
    },
    "task": "classification",
    "num_classes": 4,
    "hidden_dim": 128,
    "expert_dim": 256,
    "scales": [
      1,
      2,
      4
    ],
    "ki_factor": 4.0,
    "sample_factor": 4.0,
    "kc": 16,
    "num_experts": 4,
    "ke": 2,
    "tau_u": 0.5,
    "tau_c": 1.0,
    "tau_e": 1.0,
    "tau_d": 2.0,
    "tau_t": 0.2,
    "tau_g": 1.0,
    "lambda_r": 1.0,
    "lambda_kappa": 1.0,
    "lambda_time": 0.1,
    "conv_kernel": 3,
    "cross_mode": "sparse",
    "candidate_per_source": 32,
    "expert_training": "gumbel_st",
    "missing_policy": "finite_prior",
    "balance_convention": "raw",
    "epsilon": 1e-08,
    "logvar_min": -8.0,
    "logvar_max": 8.0,
    "sparse_temporal": true,
    "use_uncertainty": true,
    "use_moe": true,
    "expert_reliability": true,
    "separate_rho": false,
    "contextual_reliability": true,
    "reliability_context_hidden": 64,
    "reliability_context_bound": 2.0,
    "expert_residual": false
  },
  "bert": {
    "family": "deberta_v2",
    "repo_id": "microsoft/deberta-v3-large",
    "revision": "64a8c8eab3e352a784c658aef62be1662607476f",
    "local_path": null,
    "train_last_n": 24,
    "output_dim": 1024
  },
  "train": {
    "epochs": 20,
    "micro_batch_size": 16,
    "gradient_accumulation_steps": 1,
    "effective_batch_size": 16,
    "eval_batch_size": 16,
    "bert_lr": 1e-05,
    "tarc_lr": 0.0001,
    "weight_decay": 0.01,
    "warmup_fraction": 0.1,
    "clip_grad": 1.0,
    "patience": 20,
    "threads": 2,
    "missing_probability": 0.3,
    "missing_consistency": true,
    "video_balanced_sampling": false,
    "selection_metric": "weighted_f1_then_accuracy",
    "encoder_gradient_policy": "none"
  },
  "data": {
    "normalize": true
  },
  "loss": {
    "regression": "mae",
    "sign": 0.0,
    "student_task": 0.0,
    "unc": 0.0001,
    "bal": 0.01,
    "con": 0.1,
    "kd": 0.1,
    "rho": 0.1
  },
  "selective": {
    "utility_weight": 0.1,
    "endpoint_weight": 0.25,
    "temperature": 0.25,
    "initial_gate": 0.1,
    "beta": 0.5,
    "max_magnitude": 3.0,
    "sentiment_text_features": "native multipool",
    "categorical_text_features": "masked mean of text-only latent sequence",
    "label_smoothing": 0.0
  },
  "dataset": "iemocap",
  "class_names": [
    "happy_or_excited",
    "sad",
    "neutral",
    "angry"
  ]
}
